# Copy this file to .env.local and fill in from your Supabase project
# (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by future server-side code (Edge Functions run in Supabase, not here) —
# never exposed to the client. Not required for Step 1-2 (this build).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
